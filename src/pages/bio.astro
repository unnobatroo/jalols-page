---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  current="about"
  title="About – jalols.page"
  description="About Jaloliddin Ismailov — developer working in robotics and autonomous systems, climate researcher."
  canonical="/bio.html"
  type="profile"
>
  <div class="page-content page-content--narrow bio-page">
    <div class="bio-layout">
      <div class="bio-main">
        <h1 class="bio-title">Salam!</h1>
        <ul class="bio-list">
          <li><span class="bi" aria-hidden="true">👋🏻</span><span>I am Jaloliddin "Jalol" Ismailov.</span></li>
          <li><span class="bi" aria-hidden="true">🇺🇿</span><span>Proud Khorezmian.</span></li>
          <li><span class="bi" aria-hidden="true">❤️‍🔥</span><span>My passion is applying computer science to the everyday challenges me and my loved ones face – creating tools that bring us together, help us share knowledge, and increase our productivity.</span></li>
          <li><span class="bi" aria-hidden="true">🚤</span><span>Currently building a solar-powered self-driving boat at <a href="https://solarboatteam.hu">BME SBT</a>.</span></li>
          <li><span class="bi" aria-hidden="true">🎓</span><span>Studying Computer Science at ELTE in Budapest, class of 2028.</span></li>
          <li><span class="bi" aria-hidden="true">👤</span><span>Culinary maestro, cat dad, and bad writer.</span></li>
        </ul>
      </div>
      <aside class="bio-aside">
        <img class="bio-photo" src="/assets/img/jalols_photo.jpg" alt="Jaloliddin Ismailov" loading="lazy" />
      </aside>
    </div>
  </div>
</BaseLayout>
