---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { sortPosts, summarizePost } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'), import.meta.env.DEV);
  const summaries = posts.map(summarizePost);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, summaries },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  summaries: ReturnType<typeof summarizePost>[];
}

const { post, summaries } = Astro.props;
const summary = summarizePost(post);
const { Content } = await render(post);
---

<PostLayout post={summary} posts={summaries}>
  <Content />
</PostLayout>
