---
interface Props {
  current?: 'work' | 'about' | 'wiki';
}

const { current } = Astro.props;
const linkClass = (page: Props['current']) =>
  `menu-link${current === page ? ' menu-link--active' : ''}`;
const showLocalWiki = import.meta.env.DEV;
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<nav class="menu-container" aria-label="site">
  <a class={linkClass('work')} href="/" aria-current={current === 'work' ? 'page' : undefined}>work</a>
  <a class="menu-link" href="/feed.xml" aria-label="RSS feed">rss</a>
  <a class={linkClass('about')} href="/bio.html" aria-current={current === 'about' ? 'page' : undefined}>about</a>
  {showLocalWiki && (
    <a class={linkClass('wiki')} href="/wiki/" aria-current={current === 'wiki' ? 'page' : undefined}>wiki</a>
  )}
</nav>
