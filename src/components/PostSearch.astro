---
import { jsonForHtml, type PostSummary } from '../lib/site';

interface Props {
  posts: PostSummary[];
}

const { posts } = Astro.props;
---

<div class="post-search">
  <label class="sr-only" for="post-search">Search posts</label>
  <input
    type="search"
    id="post-search"
    class="search-bar"
    placeholder="search posts…"
    autocomplete="off"
  />
  <div class="search-results hidden" id="search-results" aria-live="polite" aria-atomic="true"></div>
</div>
<script is:inline id="posts-data" type="application/json" set:html={jsonForHtml(posts)}></script>
<script src="../scripts/post-search.ts"></script>
