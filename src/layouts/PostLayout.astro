---
import BaseLayout from './BaseLayout.astro';
import PostSearch from '../components/PostSearch.astro';
import { formatDate, type PostSummary } from '../lib/site';
import '../styles/comments.css';

interface Props {
  post: PostSummary;
  posts: PostSummary[];
}

const { post, posts } = Astro.props;
---

<BaseLayout
  current="work"
  title={`${post.title} — Jaloliddin Ismailov`}
  description={post.excerpt}
  image={post.image ?? '/assets/img/jalols_photo.jpg'}
  canonical={`/posts/${post.slug}/`}
  type="article"
>
  <div class="page-content page-content--narrow">
    <PostSearch posts={posts} />
    <article class="post-article">
      <header class="post-header">
        <h1>{post.title}</h1>
        <div class="post-meta">
          <time datetime={post.date}>{formatDate(new Date(`${post.date}T00:00:00Z`))}</time>
          {post.status && <> · {post.status}</>}
          {post.tags.length > 0 && (
            <> · {post.tags.map((tag) => <a class="tag" href={`/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</>
          )}
        </div>
      </header>
      <div class="post-body">
        <slot />
      </div>
    </article>
    {!post.draft && <section id="comments" aria-label="Comments"></section>}
  </div>
  <script src="../scripts/code-blocks.ts"></script>
  <script src="../scripts/comments.ts"></script>
</BaseLayout>
